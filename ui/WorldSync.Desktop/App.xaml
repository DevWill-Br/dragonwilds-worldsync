<Application x:Class="WorldSync.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
 <SolidColorBrush x:Key="Canvas" Color="#0D1119"/><SolidColorBrush x:Key="Panel" Color="#161D29"/>
 <SolidColorBrush x:Key="Text" Color="#EDF2FA"/><SolidColorBrush x:Key="Muted" Color="#94A3B8"/><SolidColorBrush x:Key="Teal" Color="#55E0BC"/>
 <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Canvas}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="29"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="#263244"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,16,18"/></Style>
 <Style TargetType="Button"><Setter Property="Background" Value="#243044"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="18,12"/><Setter Property="Margin" Value="0,4,10,4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Teal}"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Teal}"/><Setter Property="Foreground" Value="#092B23"/><Setter Property="FontWeight" Value="Bold"/></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1521"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="CaretBrush" Value="{StaticResource Teal}"/><Setter Property="BorderBrush" Value="#35435A"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,6,0,16"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0D1521"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="CaretBrush" Value="{StaticResource Teal}"/><Setter Property="BorderBrush" Value="#35435A"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,6,0,16"/></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#182232"/><Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Box" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Box" Property="Background" Value="#2C4650"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Box" Property="Background" Value="#215044"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#1D293B" CornerRadius="8" Padding="12,8"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="#94A3B8"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Margin="12,6,28,6" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" Focusable="False"><Border Background="#182232" BorderBrush="#35435A" BorderThickness="1" CornerRadius="8" MinWidth="140"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#101722"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#35445B" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>

 <Style x:Key="NavIcon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="FontSize" Value="17"/><Setter Property="Width" Value="32"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="#70BAA3"/></Style>
 <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,15"/><Setter Property="Margin" Value="0,3,0,3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBorder" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="#25473C" BorderThickness="0" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#21352F"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#2B4B40"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderThickness" Value="1"/><Setter TargetName="NavBorder" Property="BorderBrush" Value="#65C5A5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="MetricLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="9"/><Setter Property="Foreground" Value="#9AADB9"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="18,16"/><Setter Property="Margin" Value="0,0,14,16"/><Setter Property="Background" Value="#18232D"/><Setter Property="BorderBrush" Value="#2C3D43"/></Style>
 <Style x:Key="StepNumber" TargetType="Border"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#193B31"/><Setter Property="BorderBrush" Value="#2B5B49"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style x:Key="StepDigit" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Teal}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 <Style x:Key="LauncherCta" TargetType="Button" BasedOn="{StaticResource Primary}">
  <Setter Property="MinWidth" Value="345"/><Setter Property="Height" Value="58"/><Setter Property="FontSize" Value="14"/><Setter Property="Tag" Value="▶"/><Setter Property="Margin" Value="0"/>
  <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#67EBC0" Offset="0"/><GradientStop Color="#28BA99" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CtaBorder" Background="{TemplateBinding Background}" CornerRadius="13" Padding="26,16" BorderBrush="#82ECCC" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#04130E" BlurRadius="18" ShadowDepth="5" Opacity="0.35"/></Border.Effect><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="{TemplateBinding Tag}" FontSize="16" Margin="0,0,14,0" VerticalAlignment="Center"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CtaBorder" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CtaBorder" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="CtaBorder" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CtaBorder" Property="BorderBrush" Value="White"/><Setter TargetName="CtaBorder" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
</Application.Resources></Application>
