<Window x:Class="WorldSync.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource Canvas}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Title="WorldSync 2.0" Width="1250" Height="850" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111824" BorderBrush="#233044" BorderThickness="0,0,1,0"><DockPanel Margin="20,30,18,24" LastChildFill="False">
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="◈  WorldSync" FontSize="23" FontWeight="Bold"/><TextBlock Text="DRAGONWILDS  /  2.0" FontSize="10" Foreground="{StaticResource Teal}" Margin="30,6,0,36"/>
    <Button x:Name="NavHome" Content="⌂   Início" Tag="Home" Click="Navigate" HorizontalContentAlignment="Left" Background="#213B3B"/>
    <Button Content="◷   Histórico" Tag="History" Click="Navigate" HorizontalContentAlignment="Left" Background="Transparent"/>
    <Button Content="⊙   Diagnóstico" Tag="Diagnostics" Click="Navigate" HorizontalContentAlignment="Left" Background="Transparent"/>
    <Button Content="⚙   Configurações" Tag="Settings" Click="Navigate" HorizontalContentAlignment="Left" Background="Transparent"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#263244" Margin="0,0,0,20"/><TextBlock Text="SEU MUNDO, CONTINUADO" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="Um host por vez.&#10;Progresso verificado." Foreground="#C4CEDD" Margin="0,10,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="34,26,24,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,12,20"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock Text="Perfil  " VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><ComboBox x:Name="Profiles" Width="140" SelectionChanged="ProfileChanged" Padding="8"/><Button Content="Atualizar" Click="RefreshClick" Margin="12,0,0,0" Padding="14,8"/></StackPanel><TextBlock Text="WORKSPACE / MUNDO COMPARTILHADO" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
   <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" Background="#382D22" CornerRadius="10" Padding="14" Margin="0,0,16,16"><TextBlock x:Name="NoticeText" Foreground="#F7D6A5"/></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="HomePage">
      <TextBlock Text="Seu próximo capítulo começa aqui." Style="{StaticResource Title}"/><TextBlock Text="O mesmo mundo. O progresso de todos. Em qualquer host autorizado." Style="{StaticResource MutedText}"/>
      <Border Style="{StaticResource Card}" Margin="0,12,16,18" Padding="28"><StackPanel>
       <DockPanel><Border DockPanel.Dock="Right" Background="#183D34" CornerRadius="12" Padding="12,6"><TextBlock x:Name="StateBadge" Text="CONECTANDO" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="Bold"/></Border><TextBlock Text="MUNDO COMPARTILHADO" Foreground="{StaticResource Muted}" FontSize="11"/></DockPanel>
       <TextBlock x:Name="WorldName" Text="Seu mundo" FontSize="34" FontWeight="SemiBold" Margin="0,16,0,4"/><TextBlock x:Name="StateTitle" Text="Escolha seu perfil" FontSize="18" Foreground="{StaticResource Teal}"/><TextBlock x:Name="StateDetail" Text="Prepare este PC para continuar de onde o último host parou." Style="{StaticResource MutedText}" MaxWidth="640" HorizontalAlignment="Left"/>
       <Button x:Name="PrimaryButton" Content="ASSUMIR E INICIAR" Style="{StaticResource Primary}" HorizontalAlignment="Left" Padding="28,16" Margin="0,14,0,0" Click="PrimaryClick" IsEnabled="False"/>
      </StackPanel></Border>
      <UniformGrid x:Name="SummaryCards" Columns="3"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="REVISÃO CANÔNICA" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="RevisionText" Text="—" FontSize="27" Margin="0,12,0,5"/><TextBlock x:Name="IntegrityText" Text="Aguardando cloud" Foreground="{StaticResource Teal}" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="HOST ATUAL" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="HostText" Text="—" FontSize="20" Margin="0,14,0,8"/><TextBlock Text="Posse exclusiva da sessão" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ÚLTIMA SINCRONIZAÇÃO" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="SyncText" Text="—" FontSize="18" Margin="0,14,0,8"/><TextBlock x:Name="CloudText" Text="Cloud: aguardando" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border></UniformGrid>
      <Border x:Name="RecoveryPanel" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="#AA7945"><StackPanel><TextBlock Text="Recuperação necessária" FontSize="20"/><TextBlock Text="Não inicie outra sessão nem apague os registros. A recuperação automática só é habilitada para o caso já validado pelo core; outros casos precisam de análise explícita." Style="{StaticResource MutedText}"/><Button x:Name="RecoverButton" Content="Recuperar sessão" Click="RecoverClick" HorizontalAlignment="Left"/><TextBlock x:Name="RecoveryHint" Foreground="#F7D6A5"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="FlowTitle" Text="Um fluxo seguro, do início ao fim" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="FlowSummary" Text="Assumir → verificar revisão → hospedar → finalizar → sincronizar" Style="{StaticResource MutedText}"/><ItemsControl x:Name="Steps"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="HistoryPage" Visibility="Collapsed"><TextBlock Text="Histórico do mundo" Style="{StaticResource Title}"/><TextBlock Text="Revisões observadas por este app. A API atual não expõe uma lista histórica completa." Style="{StaticResource MutedText}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="REVISÃO    •    HORÁRIO LOCAL    •    HOST    •    SHA-256" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,20"/><ItemsControl x:Name="HistoryItems"/><TextBlock x:Name="HistoryEmpty" Text="Nenhuma revisão observada ainda." Foreground="{StaticResource Muted}"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed"><TextBlock Text="Tudo às claras." Style="{StaticResource Title}"/><TextBlock Text="Estado operacional sem credenciais ou conteúdo dos logs do servidor." Style="{StaticResource MutedText}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="DiagnosticText" FontFamily="Cascadia Mono, Consolas" LineHeight="28" Text="Selecione um perfil."/><WrapPanel Margin="0,20,0,0"><Button Content="Copiar diagnóstico seguro" Click="CopyDiagnostic"/><Button Content="Verificar este PC" Click="InspectClick"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><TextBlock Text="A API de status consulta o coordenador. Ela não testa o R2 separadamente. A integridade do download é verificada pelo core ao assumir; a publicação só é confirmada após commit." Foreground="{StaticResource Muted}"/></Border></StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock x:Name="SetupTitle" Text="Configurações do host" Style="{StaticResource Title}"/><TextBlock Text="Prepare este PC sem editar JSON. Cada perfil mantém seu próprio laboratório." Style="{StaticResource MutedText}"/>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1  /  Verificar o ambiente" FontSize="18"/><TextBlock x:Name="ChecksText" Text="Verifique Sandbox, virtualização, instalação copiada, laboratório e credenciais." Style="{StaticResource MutedText}"/><Button Content="Verificar pré-requisitos" Click="InspectClick" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="2  /  Perfil e caminhos" FontSize="18"/><TextBlock Text="Alterações são salvas em um NOVO perfil para preservar sessões e registros existentes. Use outro nome e um laboratório exclusivo." Style="{StaticResource MutedText}"/>
       <TextBlock Text="Endpoint cloud • somente leitura"/><TextBox x:Name="EndpointInput" Text="https://dragonwilds-worldsync-api.contactforwillbr.workers.dev" IsReadOnly="True"/>
       <UniformGrid Columns="2"><StackPanel Margin="0,0,16,0"><TextBlock Text="Perfil local"/><TextBox x:Name="ProfileInput" Text="pc-b"/></StackPanel><StackPanel><TextBlock Text="World ID"/><TextBox x:Name="WorldInput" Text="worldsynctest"/></StackPanel></UniformGrid>
       <TextBlock Text="Instalação COPIADA • sem a pasta Saved"/><TextBox x:Name="InstallInput"/><TextBlock Text="Diretório exclusivo do laboratório"/><TextBox x:Name="LabInput"/><TextBlock x:Name="HostOptions" Text="Host: nome deste PC • Sandbox: rede habilitada • instalação somente leitura" Style="{StaticResource MutedText}"/>
       <Button x:Name="SetupButton" Content="Criar perfil e configurar Sandbox" Click="SetupClick" Style="{StaticResource Primary}" HorizontalAlignment="Left"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="3  /  Credencial da cloud" FontSize="18"/><TextBlock Text="O token existente no ambiente é usado sem exibi-lo. Para outro token, informe abaixo; ele permanece apenas na memória desta execução." Style="{StaticResource MutedText}"/><PasswordBox x:Name="TokenInput"/><Button x:Name="TokenButton" Content="Usar token nesta execução" Click="TokenClick" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="4  /  Credenciais do laboratório" FontSize="18"/><TextBlock Text="Somente no INI isolado. Campos de senha vazios geram senhas fortes localmente, sem exibi-las." Style="{StaticResource MutedText}"/><TextBlock Text="Owner ID"/><PasswordBox x:Name="OwnerInput"/><TextBlock Text="Admin Password"/><PasswordBox x:Name="AdminInput"/><TextBlock Text="World Password"/><PasswordBox x:Name="WorldPasswordInput"/><Button x:Name="CredentialsButton" Content="Salvar credenciais isoladas" Click="CredentialsClick" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock Grid.Row="3" Text="WORLD SYNC 2.0   •   Progresso confirmado antes de sincronizar" Foreground="#61738C" FontSize="10" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
