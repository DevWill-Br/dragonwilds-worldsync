<Window x:Class="WorldSync.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource Canvas}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Title="WorldSync 2.0" Width="1320" Height="900" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="OnClosing">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#111824" BorderBrush="#233044" BorderThickness="0,0,1,0"><DockPanel Margin="20,30,18,24" LastChildFill="False">
   <StackPanel DockPanel.Dock="Top">
    <Grid Margin="0,0,0,38"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="38" Height="42" CornerRadius="12" Background="#163D36" BorderBrush="#357D69" BorderThickness="1" VerticalAlignment="Top"><TextBlock Text="◈" FontSize="28" Foreground="{StaticResource Teal}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="1"><TextBlock Text="WorldSync" FontSize="23" FontWeight="Bold"/><TextBlock Text="DRAGONWILDS   /   2.0" FontSize="9" Foreground="{StaticResource Teal}" Margin="1,5,0,0"/></StackPanel>
    </Grid>
    <TextBlock Text="SEU ESPAÇO" FontSize="10" Foreground="#65798C" Margin="14,0,0,12"/>
    <Button x:Name="NavHome" Tag="Home" Click="Navigate" Style="{StaticResource NavButton}" Background="#1B3933"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Início"/></StackPanel></Button>
    <Button Tag="History" Click="Navigate" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/><TextBlock Text="Histórico"/></StackPanel></Button>
    <Button Tag="Diagnostics" Click="Navigate" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Diagnóstico"/></StackPanel></Button>
    <Button Tag="Settings" Click="Navigate" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="Configurações"/></StackPanel></Button>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#263244" Margin="0,0,0,20"/><TextBlock Text="SEU MUNDO, CONTINUADO" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="Um host por vez.&#10;Progresso verificado." Foreground="#C4CEDD" Margin="0,10,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,24,22,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,12,20"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Atualizar" Click="RefreshClick" Margin="12,0,0,0" Padding="14,8"/></StackPanel><TextBlock Text="DRAGONWILDS  /  LAUNCHER" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
   <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" Background="#382D22" CornerRadius="10" Padding="14" Margin="0,0,16,16"><TextBlock x:Name="NoticeText" Foreground="#F7D6A5"/></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="HomePage">
      <Border Style="{StaticResource Card}" Padding="28,24" Margin="0,0,14,16" BorderBrush="#305346">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6"><GradientStop Color="#182C2A" Offset="0"/><GradientStop Color="#131F28" Offset="0.6"/><GradientStop Color="#17212D" Offset="1"/></LinearGradientBrush></Border.Background>
       <Grid>
        <Canvas IsHitTestVisible="False" ClipToBounds="True" HorizontalAlignment="Right" Width="280" Opacity="0.25">
         <Path Data="M0,225 L65,110 110,162 175,45 280,225 Z" Fill="#294A47"/><Path Data="M70,225 L167,90 210,145 252,78 310,225 Z" Fill="#3D6C5D"/><Path Data="M160,225 L220,152 280,212 300,250 Z" Fill="#152F2E"/>
         <Path Data="M175,45 L160,76 176,67 190,79 Z" Fill="#9CC6AE"/>
        </Canvas>
        <StackPanel>
         <DockPanel Margin="0,0,0,8"><Border x:Name="StatusSurface" DockPanel.Dock="Right" Background="#194738" BorderBrush="#337E60" BorderThickness="1" CornerRadius="10" Padding="14,8"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{Binding Foreground,ElementName=StateBadge}" Margin="0,0,8,0"/><TextBlock x:Name="StateBadge" Text="AGUARDANDO" Foreground="{StaticResource Teal}" FontSize="11" FontWeight="Bold"/></StackPanel></Border><TextBlock Text="SEU MUNDO. SUA PRÓXIMA AVENTURA." Foreground="#8EAFA7" FontSize="10" VerticalAlignment="Center"/></DockPanel>
         <TextBlock x:Name="WorldName" Text="Seu mundo" FontSize="46" FontWeight="Bold" Margin="0,0,0,4"/>
         <TextBlock Text="Mundo compartilhado com sincronização segura" Foreground="#B6C9C5" FontSize="15"/>
         <TextBlock x:Name="StateTitle" Text="Prepare seu mundo" Foreground="{StaticResource Teal}" FontSize="14" FontWeight="SemiBold" Margin="0,16,0,0"/>
         <TextBlock x:Name="StateDetail" Text="Prepare este PC para continuar de onde o último host parou." Foreground="#8FA59F" FontSize="12" MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,14"/>
         <Button x:Name="PrimaryButton" Content="ASSUMIR E JOGAR" Style="{StaticResource LauncherCta}" HorizontalAlignment="Left" Click="PrimaryClick" IsEnabled="False"/>
        </StackPanel>
       </Grid>
      </Border>
      <UniformGrid x:Name="SummaryCards" Columns="4">
       <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="◈   REVISÃO ATUAL" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="RevisionText" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,3"/><TextBlock Text="Versão canônica" Foreground="#7D94A2" FontSize="11"/></StackPanel></Border>
       <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="✓   INTEGRIDADE" Style="{StaticResource MetricLabel}"/><TextBlock Text="SHA-256" Foreground="{StaticResource Teal}" FontSize="22" FontWeight="SemiBold" Margin="0,15,0,7"/><TextBlock x:Name="IntegrityText" Text="Aguardando cloud" Foreground="#99BDB0" FontSize="11"/></StackPanel></Border>
       <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="◎   HOST ATUAL" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="HostText" Text="—" FontSize="19" FontWeight="SemiBold" Margin="0,17,0,10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/><TextBlock Text="Uma sessão por vez" Foreground="#7D94A2" FontSize="11"/></StackPanel></Border>
       <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="◷   ÚLTIMA SINCRONIZAÇÃO" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="SyncText" Text="—" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,10"/><TextBlock x:Name="CloudText" Text="Cloud: aguardando" Foreground="#7D94A2" FontSize="11"/></StackPanel></Border>
      </UniformGrid>
      <Border x:Name="RunningPanel" Style="{StaticResource Card}" Padding="20,14" Visibility="Collapsed"><UniformGrid Columns="4">
       <StackPanel><TextBlock Text="DURAÇÃO OBSERVADA" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="SessionDuration" Text="00:00:00" FontSize="19" Foreground="{StaticResource Teal}" Margin="0,8,0,3"/><TextBlock Text="Desde que o app observou o jogo" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
       <StackPanel><TextBlock Text="HEARTBEAT" Style="{StaticResource MetricLabel}"/><TextBlock Text="Sem telemetria" FontSize="15" Margin="0,10,0,3"/><TextBlock Text="Gerenciado pelo supervisor" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
       <StackPanel><TextBlock Text="REVISÃO BASE" Style="{StaticResource MetricLabel}"/><TextBlock Text="Não informada pela ponte" FontSize="13" Margin="0,10,0,3"/><TextBlock Text="Validação mantida no core" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
       <StackPanel><TextBlock Text="INTEGRIDADE" Style="{StaticResource MetricLabel}"/><TextBlock Text="Validada ao assumir" FontSize="14" Foreground="{StaticResource Teal}" Margin="0,10,0,3"/><TextBlock Text="Snapshot verificado ao sincronizar" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
      </UniformGrid></Border>
      <Border x:Name="RecoveryPanel" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="#AA7945"><StackPanel><TextBlock Text="Recuperação necessária" FontSize="20"/><TextBlock Text="Não inicie outra sessão nem apague os registros. A sessão e os backups foram preservados. Este caso requer análise explícita antes de retomar." Style="{StaticResource MutedText}"/><Button x:Name="RecoverButton" Content="Recuperar sessão" Click="RecoverClick" HorizontalAlignment="Left"/><TextBlock x:Name="RecoveryHint" Foreground="#F7D6A5"/></StackPanel></Border>
      <Border x:Name="FlowSurface" Style="{StaticResource Card}" Padding="20,16"><StackPanel>
       <DockPanel><TextBlock x:Name="FlowTitle" Text="Da última aventura à próxima" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="FlowSummary" Text="Um mundo contínuo, quatro passos." Foreground="#8AA59B" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
       <UniformGrid x:Name="Journey" Columns="4" Margin="0,18,0,0">
        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource StepNumber}"><TextBlock Text="1" Style="{StaticResource StepDigit}"/></Border><TextBlock Text="Assumir" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource StepNumber}"><TextBlock Text="2" Style="{StaticResource StepDigit}"/></Border><TextBlock Text="Abrir jogo" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource StepNumber}"><TextBlock Text="3" Style="{StaticResource StepDigit}"/></Border><TextBlock Text="Jogar" VerticalAlignment="Center"/></StackPanel>
        <StackPanel Orientation="Horizontal"><Border Style="{StaticResource StepNumber}"><TextBlock Text="4" Style="{StaticResource StepDigit}"/></Border><TextBlock Text="Sair do jogo e&#10;sincronizar" VerticalAlignment="Center" FontSize="12"/></StackPanel>
       </UniformGrid>
       <ItemsControl x:Name="Steps" Margin="0,10,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="20,16"><StackPanel>
       <TextBlock Text="☁   ESTADO DA CLOUD" FontSize="11" Foreground="#9EB4BE" FontWeight="SemiBold" Margin="0,0,0,14"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="API" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="ApiHealth" Text="Aguardando" Foreground="{StaticResource Teal}" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="R2 / ARMAZENAMENTO" Style="{StaticResource MetricLabel}"/><TextBlock Text="Sem verificação independente" Foreground="#9CAEBB" FontSize="12" Margin="0,6,0,0"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="SESSÃO" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="CloudSession" Text="Aguardando" Foreground="{StaticResource Teal}" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
       </Grid>
      </StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="HistoryPage" Visibility="Collapsed"><TextBlock Text="Histórico do mundo" Style="{StaticResource Title}"/><TextBlock Text="Revisões observadas por este app. A API atual não expõe uma lista histórica completa." Style="{StaticResource MutedText}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="REVISÃO    •    HORÁRIO LOCAL    •    HOST    •    SHA-256" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,20"/><ItemsControl x:Name="HistoryItems"/><TextBlock x:Name="HistoryEmpty" Text="Nenhuma revisão observada ainda." Foreground="{StaticResource Muted}"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed"><TextBlock Text="Tudo às claras." Style="{StaticResource Title}"/><TextBlock Text="Estado operacional sem credenciais ou conteúdo dos logs do jogo." Style="{StaticResource MutedText}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="DiagnosticText" FontFamily="Cascadia Mono, Consolas" LineHeight="28" Text="Prepare este PC."/><WrapPanel Margin="0,20,0,0"><Button Content="Copiar diagnóstico seguro" Click="CopyDiagnostic"/><Button Content="Verificar este PC" Click="InspectClick"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><TextBlock Text="A API de status consulta o coordenador. Ela não testa o R2 separadamente. A integridade do download é verificada pelo core ao assumir; a publicação só é confirmada após commit." Foreground="{StaticResource Muted}"/></Border></StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock x:Name="SetupTitle" Text="Configurações do host" Style="{StaticResource Title}"/><TextBlock Text="Prepare este PC sem editar JSON. Selecione apenas o arquivo do mundo que deseja compartilhar." Style="{StaticResource MutedText}"/>
      <Border Style="{StaticResource Card}" Padding="20,16"><Expander x:Name="AdvancedProfiles" Header="Avançado" Foreground="{StaticResource Text}" IsExpanded="False"><StackPanel Margin="0,16,0,0">
       <TextBlock Text="Perfis locais" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock x:Name="ProfilesHint" Text="O perfil deste PC é selecionado automaticamente." Style="{StaticResource MutedText}"/>
       <ComboBox x:Name="Profiles" Width="240" HorizontalAlignment="Left" SelectionChanged="ProfileChanged" Padding="8"/>
       <TextBlock Text="Para criar outro perfil, use o setup abaixo. Perfis existentes não são alterados." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
      </StackPanel></Expander></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1 / Preparar este PC" FontSize="18"/><TextBlock x:Name="ChecksText" Text="Verifique o jogo instalado e a credencial da cloud." Style="{StaticResource MutedText}"/><Button Content="Verificar este PC" Click="InspectClick" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="2 / Adicionar mundo existente" FontSize="18"/>
       <TextBlock Text="Feche Dragonwilds antes de descobrir arquivos. O nome dentro do jogo pode ser diferente do nome do arquivo: confirme a correspondência antes de adotar. Nenhum mundo é publicado ao criar o perfil." Style="{StaticResource MutedText}"/>
       <Button x:Name="DiscoverButton" Content="Descobrir saves locais" Click="DiscoverClick" HorizontalAlignment="Left"/>
       <ComboBox x:Name="WorldFiles" SelectionChanged="WorldFileChanged" DisplayMemberPath="Label" Margin="0,10"/>
       <TextBlock x:Name="SaveDirectory" Text="Diretório ainda não descoberto" Style="{StaticResource MutedText}"/>
       <TextBlock Text="Nome de exibição do mundo"/><TextBox x:Name="DisplayNameInput" Text="Posto da Mata"/>
       <UniformGrid Columns="2"><StackPanel Margin="0,0,16,0"><TextBlock Text="Perfil local"/><TextBox x:Name="ProfileInput" Text="local-pc"/></StackPanel><StackPanel><TextBlock Text="World ID compartilhado"/><TextBox x:Name="WorldInput" Text="posto-da-mata"/></StackPanel></UniformGrid>
       <TextBlock Text="Arquivo selecionado / destino neste PC (.sav)"/><TextBox x:Name="SaveFileInput"/>
       <TextBlock Text="No PC B, use o mesmo worldId e o nome de arquivo confirmado pelo PC A. Não adote novamente: crie o perfil e use Assumir e jogar." Style="{StaticResource MutedText}"/>
       <CheckBox x:Name="AutoLaunch" IsChecked="True" Content="Abrir Dragonwilds automaticamente ao assumir" Margin="0,12" Foreground="{StaticResource Text}"/>
       <TextBlock x:Name="HostOptions" Style="{StaticResource MutedText}"/>
       <WrapPanel><Button x:Name="SetupButton" Content="Criar perfil local" Click="SetupClick" Style="{StaticResource Primary}"/><Button x:Name="OptionsButton" Content="Salvar opção de abertura" Click="OptionsClick"/></WrapPanel>
       <TextBlock Text="Endpoint cloud • somente leitura" Margin="0,14,0,0"/><TextBox x:Name="EndpointInput" Text="https://dragonwilds-worldsync-api.contactforwillbr.workers.dev" IsReadOnly="True"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="3 / Credencial da cloud" FontSize="18"/><TextBlock Text="O token do ambiente é usado sem exibi-lo. Um token informado aqui permanece apenas na memória desta execução." Style="{StaticResource MutedText}"/><PasswordBox x:Name="TokenInput"/><Button x:Name="TokenButton" Content="Usar token nesta execução" Click="TokenClick" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" BorderBrush="#AA7945"><StackPanel><TextBlock Text="4 / Adotar como primeira revisão" FontSize="18"/><TextBlock Text="Somente no primeiro PC e com o jogo fechado. Descubra e selecione o arquivo acima; crie o perfil. A confirmação exibirá arquivo, mundo e SHA-256. Se já existir uma revisão na cloud, a adoção será recusada." Style="{StaticResource MutedText}"/><Button x:Name="AdoptButton" Content="Revisar adoção do mundo local" Click="AdoptClick" HorizontalAlignment="Left" IsEnabled="False"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock Grid.Row="3" Text="WORLD SYNC 2.0   •   Progresso confirmado antes de sincronizar" Foreground="#61738C" FontSize="10" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
