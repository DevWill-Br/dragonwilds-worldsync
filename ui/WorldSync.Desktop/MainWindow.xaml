<Window x:Class="WorldSync.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource Canvas}" Foreground="{StaticResource Text}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Title="WorldSync 2.0" Width="1540" Height="1040" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="OnClosing" SizeChanged="LayoutChanged">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarWidth" Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#071319" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,0,1,0"><DockPanel Margin="20,30,18,24" LastChildFill="False">
   <StackPanel DockPanel.Dock="Top">
    <Border BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,0,0,1" Padding="4,0,0,22" Margin="0,0,0,24"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCloud}" Style="{StaticResource OutlineIcon}" Width="32" Height="32" Stroke="{StaticResource Teal}" Margin="0,0,12,0"/><StackPanel><TextBlock x:Name="BrandName" Text="WorldSync 2.0" FontSize="22" FontWeight="Bold"/><TextBlock Text="LAUNCHER" FontSize="10" Foreground="{StaticResource Teal}" Margin="0,5,0,0"/></StackPanel></StackPanel></Border>
    <Button x:Name="NavHome" Tag="Home" Click="Navigate" Style="{StaticResource NavButton}" Background="#1B3933"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/><TextBlock Text="Início"/></StackPanel></Button>
    <Button Tag="History" Click="Navigate" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}"/><TextBlock Text="Histórico"/></StackPanel></Button>
    <Button Tag="Diagnostics" Click="Navigate" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/><TextBlock Text="Diagnóstico"/></StackPanel></Button>
    <Button Tag="Settings" Click="Navigate" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/><TextBlock Text="Configurações"/></StackPanel></Button>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#263244" Margin="0,0,0,20"/><TextBlock Text="WORLDSYNC 2.0" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="Sincronize aventuras.&#10;Jogue juntos, sempre." Foreground="#C4CEDD" Margin="0,10,0,0"/></StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,16,20,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,12,20"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock x:Name="CloudText" Text="Cloud: aguardando" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/><Button Content="Atualizar" Click="RefreshClick" Margin="12,0,0,0" Padding="14,8"/></StackPanel><TextBlock Text="DRAGONWILDS  /  LAUNCHER" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
   <Border x:Name="Notice" Grid.Row="1" Visibility="Collapsed" Background="#382D22" CornerRadius="10" Padding="14" Margin="0,0,16,16"><TextBlock x:Name="NoticeText" Foreground="#F7D6A5"/></Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="HomePage">
      <Border CornerRadius="18" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" Margin="0,0,12,18">
       <Border.Background><ImageBrush ImageSource="Assets/worldsync-hero.png" Stretch="UniformToFill" AlignmentY="Center"/></Border.Background>
       <Border CornerRadius="18" Background="{StaticResource HeroShade}" Padding="28" MinHeight="202">
        <Grid x:Name="HeroGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="HeroStatusColumn" Width="310"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid VerticalAlignment="Center" Margin="0,12,20,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="WorldOrb" Width="82" Height="82" CornerRadius="41" Background="#8802484A" BorderBrush="{StaticResource Teal}" BorderThickness="1" Margin="0,0,22,0"><Path Data="{StaticResource IconGlobe}" Style="{StaticResource OutlineIcon}" Width="48" Height="48" Stroke="{StaticResource Teal}"/></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="SEU MUNDO COMPARTILHADO" FontSize="12" Foreground="{StaticResource Teal}" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock x:Name="WorldName" Text="Seu mundo" FontSize="48" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"/><TextBlock Text="Mundo compartilhado com sincronização segura." Foreground="#D0DFE0" FontSize="17" Margin="0,10,0,0"/></StackPanel>
         </Grid>
         <Border x:Name="StatusSurface" Grid.Column="1" VerticalAlignment="Center" CornerRadius="16" BorderThickness="1" BorderBrush="#73557080" Background="#DE052A2A" Padding="20" MinHeight="112">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="18" Height="18" Fill="{Binding Foreground,ElementName=StateBadge}" Margin="0,0,18,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="StateBadge" Text="AGUARDANDO" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="StateTitle" Text="Prepare este PC" FontSize="14" Foreground="#B5C8CB" Margin="0,7,0,0"/></StackPanel></Grid>
         </Border>
        </Grid>
       </Border>
      </Border>
      <UniformGrid x:Name="SummaryCards" Columns="4">
       <Border Style="{StaticResource MetricTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource MetricIconBox}"><Path Data="{StaticResource IconLayers}" Style="{StaticResource OutlineIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Revisão atual" Foreground="{StaticResource TextSecondary}" FontSize="14"/><TextBlock x:Name="RevisionText" Text="—" Style="{StaticResource MetricValue}"/></StackPanel></Grid></Border>
       <Border Style="{StaticResource MetricTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource MetricIconBox}"><Path Data="{StaticResource IconShield}" Style="{StaticResource OutlineIcon}" Stroke="{StaticResource Teal}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Integridade" Foreground="{StaticResource TextSecondary}" FontSize="14"/><TextBlock x:Name="IntegrityText" Text="Aguardando" Style="{StaticResource MetricValue}" Foreground="{StaticResource Teal}"/></StackPanel></Grid></Border>
       <Border Style="{StaticResource MetricTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource MetricIconBox}"><Path Data="{StaticResource IconUser}" Style="{StaticResource OutlineIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Host atual" Foreground="{StaticResource TextSecondary}" FontSize="14"/><TextBlock x:Name="HostText" Text="—" Style="{StaticResource MetricValue}"/></StackPanel></Grid></Border>
       <Border Style="{StaticResource MetricTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource MetricIconBox}"><Path Data="{StaticResource IconClock}" Style="{StaticResource OutlineIcon}" Stroke="{StaticResource Warning}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Última sincronização" Foreground="{StaticResource TextSecondary}" FontSize="14"/><TextBlock x:Name="SyncText" Text="—" Style="{StaticResource MetricValue}" Foreground="{StaticResource Warning}"/></StackPanel></Grid></Border>
      </UniformGrid>
      <Border x:Name="RunningPanel" Style="{StaticResource Card}" Padding="20,14" Visibility="Collapsed"><UniformGrid Columns="4">
       <StackPanel><TextBlock Text="DURAÇÃO OBSERVADA" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="SessionDuration" Text="00:00:00" FontSize="19" Foreground="{StaticResource Teal}" Margin="0,8,0,3"/><TextBlock Text="Desde que o app observou o jogo" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
       <StackPanel><TextBlock Text="HEARTBEAT" Style="{StaticResource MetricLabel}"/><TextBlock Text="Sem telemetria" FontSize="15" Margin="0,10,0,3"/><TextBlock Text="Gerenciado pelo supervisor" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
       <StackPanel><TextBlock Text="REVISÃO BASE" Style="{StaticResource MetricLabel}"/><TextBlock Text="Não informada pela ponte" FontSize="13" Margin="0,10,0,3"/><TextBlock Text="Validação mantida no core" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
       <StackPanel><TextBlock Text="INTEGRIDADE" Style="{StaticResource MetricLabel}"/><TextBlock Text="Validada ao assumir" FontSize="14" Foreground="{StaticResource Teal}" Margin="0,10,0,3"/><TextBlock Text="Snapshot verificado ao sincronizar" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
      </UniformGrid></Border>
      <Border x:Name="RecoveryPanel" Style="{StaticResource Card}" Visibility="Collapsed" BorderBrush="#AA7945"><StackPanel><TextBlock Text="Recuperação necessária" FontSize="20"/><TextBlock Text="Não inicie outra sessão nem apague os registros. A sessão e os backups foram preservados. Este caso requer análise explícita antes de retomar." Style="{StaticResource MutedText}"/><Button x:Name="RecoverButton" Content="Recuperar sessão" Click="RecoverClick" HorizontalAlignment="Left"/><TextBlock x:Name="RecoveryHint" Foreground="#F7D6A5"/></StackPanel></Border>
      <Grid x:Name="WorkspaceGrid" Margin="0,6,12,0"><Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftWorkspaceColumn" Width="1.22*"/><ColumnDefinition x:Name="WorkspaceGap" Width="18"/><ColumnDefinition x:Name="RightWorkspaceColumn" Width="0.95*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel x:Name="LeftWorkspace">
        <TextBlock x:Name="StateDetail" Text="Assuma o mundo, abra o jogo e comece a jogar." Visibility="Collapsed"/>
        <Button x:Name="PrimaryButton" Content="ASSUMIR E INICIAR" ToolTip="{Binding Text,ElementName=StateDetail}" Style="{StaticResource LauncherCta}" Click="PrimaryClick" IsEnabled="False"/>
        <Border Style="{StaticResource LauncherPanel}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Path Data="{StaticResource IconCloud}" Style="{StaticResource OutlineIcon}" Margin="0,0,12,0"/><TextBlock Text="Estado da Cloud" Style="{StaticResource LauncherHeading}"/></StackPanel>
         <Border BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="12"><StackPanel>
          <Border Style="{StaticResource CloudRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconPulse}" Style="{StaticResource OutlineIcon}" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="API" FontWeight="SemiBold"/><TextBlock Text="Estado informado pelo coordenador." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" x:Name="ApiHealth" Text="Aguardando" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Border>
          <Border Style="{StaticResource CloudRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconLayers}" Style="{StaticResource OutlineIcon}" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="R2" FontWeight="SemiBold"/><TextBlock Text="Sem verificação independente." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" x:Name="R2Health" Text="Não verificado" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Border>
          <Border Style="{StaticResource CloudRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><Path Data="{StaticResource IconLink}" Style="{StaticResource OutlineIcon}" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Sessão" FontWeight="SemiBold"/><TextBlock Text="Posse exclusiva do mundo." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" x:Name="CloudSession" Text="Aguardando" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right"/></Grid></Border>
         </StackPanel></Border>
        </StackPanel></Border>
       </StackPanel>
       <StackPanel x:Name="RightWorkspace" Grid.Column="2">
        <Border x:Name="FlowSurface" Style="{StaticResource LauncherPanel}"><StackPanel>
         <StackPanel Orientation="Horizontal" Margin="0,0,0,18"><Path Data="{StaticResource IconList}" Style="{StaticResource OutlineIcon}" Margin="0,0,12,0"/><TextBlock x:Name="FlowTitle" Text="Próximo fluxo" Style="{StaticResource LauncherHeading}"/></StackPanel>
         <UniformGrid x:Name="Journey" Columns="4">
          <StackPanel><Border x:Name="FlowStep1" Style="{StaticResource FlowCircle}"><TextBlock Text="1" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Assumir" Style="{StaticResource FlowLabel}"/><TextBlock Text="Reserve o mundo para sua sessão." Style="{StaticResource FlowCopy}"/></StackPanel>
          <StackPanel><Border x:Name="FlowStep2" Style="{StaticResource FlowCircle}"><TextBlock Text="2" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Abrir jogo" Style="{StaticResource FlowLabel}"/><TextBlock Text="Abra Dragonwilds normalmente." Style="{StaticResource FlowCopy}"/></StackPanel>
          <StackPanel><Border x:Name="FlowStep3" Style="{StaticResource FlowCircle}"><TextBlock Text="3" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Jogar" Style="{StaticResource FlowLabel}"/><TextBlock Text="Aproveite com seus amigos." Style="{StaticResource FlowCopy}"/></StackPanel>
          <StackPanel><Border x:Name="FlowStep4" Style="{StaticResource FlowCircle}"><TextBlock Text="4" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Encerrar e sincronizar" Style="{StaticResource FlowLabel}"/><TextBlock Text="Feche o jogo; aguarde a sincronização." Style="{StaticResource FlowCopy}"/></StackPanel>
         </UniformGrid>
         <ItemsControl x:Name="Steps"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
         <TextBlock x:Name="FlowSummary" Text="Uma sessão por vez, do início à sincronização." Foreground="{StaticResource TextTertiary}" FontSize="12" Margin="0,18,0,0"/>
        </StackPanel></Border>
        <Border Style="{StaticResource LauncherPanel}"><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Path Data="{StaticResource IconChart}" Style="{StaticResource OutlineIcon}" Margin="0,0,12,0"/><TextBlock Text="Resumo" Style="{StaticResource LauncherHeading}"/></StackPanel>
         <Border BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,1,0,0" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Disponibilidade" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="SummaryAvailability" Grid.Column="1" Text="Aguardando" TextAlignment="Right" Foreground="{StaticResource TextSecondary}"/></Grid></Border>
         <Border BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,1,0,0" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Save canônico" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="SummaryCanonical" Grid.Column="1" Text="Aguardando" TextAlignment="Right" Foreground="{StaticResource TextSecondary}"/></Grid></Border>
         <Border BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="0,1,0,0" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Diagnóstico" Foreground="{StaticResource TextSecondary}"/><TextBlock x:Name="SummaryDiagnostic" Grid.Column="1" Text="Aguardando" TextAlignment="Right" Foreground="{StaticResource TextSecondary}"/></Grid></Border>
        </StackPanel></Border>
       </StackPanel>
      </Grid>
     </StackPanel>
     <StackPanel x:Name="HistoryPage" Visibility="Collapsed"><TextBlock Text="Histórico do mundo" Style="{StaticResource Title}"/><TextBlock Text="Revisões observadas por este app. A API atual não expõe uma lista histórica completa." Style="{StaticResource MutedText}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="REVISÃO    •    HORÁRIO LOCAL    •    HOST    •    SHA-256" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,20"/><ItemsControl x:Name="HistoryItems"/><TextBlock x:Name="HistoryEmpty" Text="Nenhuma revisão observada ainda." Foreground="{StaticResource Muted}"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="DiagnosticsPage" Visibility="Collapsed"><TextBlock Text="Tudo às claras." Style="{StaticResource Title}"/><TextBlock Text="Estado operacional sem credenciais ou conteúdo dos logs do jogo." Style="{StaticResource MutedText}"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="DiagnosticText" FontFamily="Cascadia Mono, Consolas" LineHeight="28" Text="Prepare este PC."/><WrapPanel Margin="0,20,0,0"><Button Content="Copiar diagnóstico seguro" Click="CopyDiagnostic"/><Button Content="Verificar este PC" Click="InspectClick"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><TextBlock Text="A API de status consulta o coordenador. Ela não testa o R2 separadamente. A integridade do download é verificada pelo core ao assumir; a publicação só é confirmada após commit." Foreground="{StaticResource Muted}"/></Border></StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock x:Name="SetupTitle" Text="Configurações do host" Style="{StaticResource Title}"/><TextBlock Text="Prepare este PC sem editar JSON. Selecione apenas o arquivo do mundo que deseja compartilhar." Style="{StaticResource MutedText}"/>
      <Border Style="{StaticResource Card}" Padding="20,16"><Expander x:Name="AdvancedProfiles" Header="Avançado" Foreground="{StaticResource Text}" IsExpanded="False"><StackPanel Margin="0,16,0,0">
       <TextBlock Text="Perfis locais" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock x:Name="ProfilesHint" Text="O perfil deste PC é selecionado automaticamente." Style="{StaticResource MutedText}"/>
       <ComboBox x:Name="Profiles" Width="240" HorizontalAlignment="Left" SelectionChanged="ProfileChanged" Padding="8"/>
       <TextBlock Text="Para criar outro perfil, use o setup abaixo. Perfis existentes não são alterados." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/>
      </StackPanel></Expander></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1 / Preparar este PC" FontSize="18"/><TextBlock x:Name="ChecksText" Text="Verifique o jogo instalado e a credencial da cloud." Style="{StaticResource MutedText}"/><Button Content="Verificar este PC" Click="InspectClick" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="2 / Adicionar mundo existente" FontSize="18"/>
       <TextBlock Text="Feche Dragonwilds antes de descobrir arquivos. O nome dentro do jogo pode ser diferente do nome do arquivo: confirme a correspondência antes de adotar. Nenhum mundo é publicado ao criar o perfil." Style="{StaticResource MutedText}"/>
       <Button x:Name="DiscoverButton" Content="Descobrir saves locais" Click="DiscoverClick" HorizontalAlignment="Left"/>
       <ComboBox x:Name="WorldFiles" SelectionChanged="WorldFileChanged" DisplayMemberPath="Label" Margin="0,10"/>
       <TextBlock x:Name="SaveDirectory" Text="Diretório ainda não descoberto" Style="{StaticResource MutedText}"/>
       <TextBlock Text="Nome de exibição do mundo"/><TextBox x:Name="DisplayNameInput" Text="Posto da Mata"/>
       <UniformGrid Columns="2"><StackPanel Margin="0,0,16,0"><TextBlock Text="Perfil local"/><TextBox x:Name="ProfileInput" Text="local-pc"/></StackPanel><StackPanel><TextBlock Text="World ID compartilhado"/><TextBox x:Name="WorldInput" Text="posto-da-mata"/></StackPanel></UniformGrid>
       <TextBlock Text="Arquivo selecionado / destino neste PC (.sav)"/><TextBox x:Name="SaveFileInput"/>
       <TextBlock Text="No PC B, use o mesmo worldId e o nome de arquivo confirmado pelo PC A. Não adote novamente: crie o perfil e use Assumir e jogar." Style="{StaticResource MutedText}"/>
       <CheckBox x:Name="AutoLaunch" IsChecked="True" Content="Abrir Dragonwilds automaticamente ao assumir" Margin="0,12" Foreground="{StaticResource Text}"/>
       <TextBlock x:Name="HostOptions" Style="{StaticResource MutedText}"/>
       <WrapPanel><Button x:Name="SetupButton" Content="Criar perfil local" Click="SetupClick" Style="{StaticResource Primary}"/><Button x:Name="OptionsButton" Content="Salvar opção de abertura" Click="OptionsClick"/></WrapPanel>
       <TextBlock Text="Endpoint cloud • somente leitura" Margin="0,14,0,0"/><TextBox x:Name="EndpointInput" Text="https://dragonwilds-worldsync-api.contactforwillbr.workers.dev" IsReadOnly="True"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="3 / Credencial da cloud" FontSize="18"/><TextBlock x:Name="CredentialStatus" Text="Credencial não configurada" Style="{StaticResource MutedText}"/><TextBlock Text="Salva no Gerenciador de Credenciais do Windows para este usuário. O token nunca será exibido novamente. A variável de ambiente continua disponível como alternativa." Style="{StaticResource MutedText}"/><StackPanel x:Name="CredentialEditor"><PasswordBox x:Name="TokenInput"/><Button x:Name="TokenButton" Content="Salvar credencial com segurança" Click="TokenClick" HorizontalAlignment="Left"/></StackPanel><WrapPanel x:Name="CredentialActions" Visibility="Collapsed"><Button x:Name="ReplaceTokenButton" Content="Substituir credencial" Click="ReplaceTokenClick"/><Button x:Name="RemoveTokenButton" Content="Remover credencial" Click="RemoveTokenClick"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}" BorderBrush="#AA7945"><StackPanel><TextBlock Text="4 / Adotar como primeira revisão" FontSize="18"/><TextBlock Text="Somente no primeiro PC e com o jogo fechado. Descubra e selecione o arquivo acima; crie o perfil. A confirmação exibirá arquivo, mundo e SHA-256. Se já existir uma revisão na cloud, a adoção será recusada." Style="{StaticResource MutedText}"/><Button x:Name="AdoptButton" Content="Revisar adoção do mundo local" Click="AdoptClick" HorizontalAlignment="Left" IsEnabled="False"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <TextBlock Grid.Row="3" Text="WORLD SYNC 2.0   •   Progresso confirmado antes de sincronizar" Foreground="#61738C" FontSize="10" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
