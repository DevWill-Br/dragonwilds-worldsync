 <Style x:Key="LauncherCta" TargetType="Button" BasedOn="{StaticResource Primary}">
  <Setter Property="MinHeight" Value="164"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="Foreground" Value="White"/><Setter Property="Tag" Value="▶"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="CtaBorder" CornerRadius="16" BorderBrush="#D962FFE0" BorderThickness="1" Padding="22">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1DE0C4" Offset="0"/><GradientStop Color="#0CAA92" Offset="0.55"/><GradientStop Color="#087F70" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
     <Border Width="80" Height="80" Background="#4D01695E" CornerRadius="40" Margin="0,0,20,0"><TextBlock Text="{TemplateBinding Tag}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/></Border>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="28" Foreground="White" TextWrapping="Wrap"/><TextBlock Text="{TemplateBinding ToolTip}" FontWeight="Normal" FontSize="14" Foreground="#F2FFFFFF" Margin="0,10,8,0" TextWrapping="Wrap"/></StackPanel>
     <TextBlock Grid.Column="2" Text="›" FontSize="34" VerticalAlignment="Center" Foreground="White"/>
    </Grid>
   </Border>
   <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CtaBorder" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CtaBorder" Property="Opacity" Value="0.86"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="CtaBorder" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CtaBorder" Property="BorderThickness" Value="3"/><Setter TargetName="CtaBorder" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
